{
  "name": "richards-intelligence-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.16.1",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "prisma generate && next build",
    "start": "next start --hostname 0.0.0.0",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "test": "tsx --test tests/*.test.ts",
    "test:db": "node scripts/test-db-prepare.mjs",
    "test:integration": "pnpm test:db && tsx --test --test-concurrency=1 tests/integration/*.test.ts",
    "test:e2e": "node scripts/e2e/run.mjs",
    "simulate": "node scripts/iot-simulator.mjs",
    "mqtt": "tsx src/iot/run-mqtt.ts",
    "bancada": "tsx src/iot/run-bancada-virtual.ts",
    "palco:checar": "tsx src/iot/run-bancada-virtual.ts --checar"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@tailwindcss/postcss": "^4.1.0",
    "dotenv": "^16.4.7",
    "lucide-react": "^0.468.0",
    "mqtt": "5.16.1",
    "next": "^16.2.0",
    "pdf-lib": "^1.17.1",
    "pg": "^8.16.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^2.15.4",
    "tailwindcss": "^4.1.0",
    "three": "0.186.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "0.186.0",
    "eslint": "^9.25.0",
    "eslint-config-next": "^16.2.0",
    "prisma": "7.10.1",
    "puppeteer-core": "24.43.1",
    "tsx": "^4.19.0",
    "typescript": "^5.9.0"
  }
}
