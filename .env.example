# Copie para .env antes de executar. Não publique segredos no Git.
# Usada pelo docker-compose (banco e URL do container web). Ao trocar, use a MESMA senha no DATABASE_URL abaixo.
POSTGRES_PASSWORD="richards_dev_change_me"
DATABASE_URL="postgresql://richards:richards_dev_change_me@localhost:5432/richards?schema=public"
# Banco SEPARADO para `pnpm test:integration` (o nome precisa terminar em _test; os testes apagam os dados DELE).
TEST_DATABASE_URL="postgresql://richards:richards_dev_change_me@localhost:5432/richards_test?schema=public"
DEMO_MODE="true"
# NÃO defina na demo: desde 06/11 o seed grava só o cadastro-base (docs/DADOS_REAIS.md). "true" cria o cenário fictício
# (histórico SIMULATED, ocorrências, lotes e instituições "· Demonstração"): só para banco de teste; o E2E já define.
# SEED_DEMO_DATA="true"
# false somente em localhost durante desenvolvimento. Use true quando expuser a demonstração.
AUTH_MODE="basic"
RICHARDS_OPERATOR_USER="operador"
RICHARDS_OPERATOR_PASSWORD="troque-esta-senha"
IOT_DEMO_DEVICE_KEY="troque-esta-chave-dispositivo"
NEXT_PUBLIC_APP_NAME="RICHARDS Intelligence"

# Opcionais do `pnpm test:e2e`: porta da instância isolada (padrão 3100) e navegador, se não for o Chrome/Edge padrão.
# E2E_PORT=3100
# CHROME_PATH="C:/Program Files/Google/Chrome/Application/chrome.exe"

# Ponte MQTT da bancada (`pnpm mqtt`, processo separado do site). Ver docs/CONTRATO_IOT.md, seção "Canal MQTT".
# Sem usuário e senha, qualquer equipamento da rede publica leituras: a ponte só aceita isso com DEMO_MODE="true".
MQTT_BROKER_URL="mqtt://localhost:1883"
# Usuário e senha da PONTE no broker. Com `docker compose --profile iot up -d` (broker + ponte, ideia do PR #4),
# o broker sobe com estes e com MQTT_DEVICE_USER/MQTT_DEVICE_PASSWORD (o ESP32), sem acesso anônimo e com ACL.
MQTT_USERNAME="richards-ponte"
MQTT_PASSWORD=""
# MQTT_DEVICE_USER="hortifruti_01"
# MQTT_DEVICE_PASSWORD=""
# Para o ESP32 da rede do evento alcançar o broker do notebook (só em rede isolada): MQTT_BIND_ADDR="0.0.0.0"
MQTT_TOPIC="richards/comercio/telemetria"
# dispositivo_id do firmware → código do Device cadastrado (sem isso, o id precisa ser o próprio código).
MQTT_DEVICE_ALIASES="hortifruti_01=RICHARDS-FLOW-001"
# Sensores que NÃO medem o fenômeno real na bancada são gravados como SIMULATED. Potenciômetro no lugar do
# YF-S201 = "VAZAO" (padrão). Com o sensor de vazão real ligado, use "".
MQTT_SIMULATED_SENSORS="VAZAO"
# Opcionais (padrões entre parênteses): intervalo do firmware (2 s), temperatura acima de X °C (28) por N s (30),
# balança estável a partir de X kg (1,5 na bancada física) por N s (6).
# MQTT_SAMPLE_SECONDS=2
# MQTT_TEMP_LIMIT_C=28
# MQTT_TEMP_SECONDS=30
MQTT_SCALE_MIN_KG=1.5
# MQTT_SCALE_STABLE_SECONDS=6
# Confiabilidade (docs/CONTRATO_IOT.md, "Garantias e riscos residuais da ponte"): a ponte confirma ao broker na chegada e
# grava por uma fila em memória; com o banco fora, cada mensagem espera até N s (120) com a hora de chegada e depois vai
# para a carta morta (também com fila cheia, erro permanente ou Ctrl+C). "true" exige <tópico>/<dispositivo_id>.
# MQTT_RETRY_BUDGET_SECONDS=120
# MQTT_DEAD_LETTER=.mqtt-dead-letter.ndjson
# MQTT_REQUIRE_DEVICE_TOPIC=false
# MQTT_KEEPALIVE_SECONDS=60
# MQTT_QUEUE_MAX=2000

# RICHARDS Assist (opcional; servidor somente). Nunca coloque chave em NEXT_PUBLIC_*.
ASSISTANT_ENABLED="false"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4.1-mini"
# Limite diário UTC do workspace; até 3 respostas de modelo por pergunta. Ajustar crédito no painel OpenAI também.
ASSISTANT_DAILY_REQUEST_LIMIT="200"
ASSISTANT_MINUTE_REQUEST_LIMIT="6"
TELEGRAM_ENABLED="false"
TELEGRAM_BOT_TOKEN=""
# Sem @; precisa coincidir com getMe do token configurado.
TELEGRAM_BOT_USERNAME=""
# Origem de acesso ao BI, sem credenciais/query. Preferir HTTPS acessível no celular.
ASSISTANT_BASE_URL="http://localhost:3000"
ASSISTANT_ESCALATION_MINUTES="15"
# Horário São Paulo, 0-23; somente para assinaturas que ativarem resumo.
ASSISTANT_SUMMARY_HOUR="8"
