# Copie para .env antes de executar. Não publique segredos no Git.
# Usada pelo docker-compose (banco e URL do container web). Ao trocar, use a MESMA senha no DATABASE_URL abaixo.
POSTGRES_PASSWORD="richards_dev_change_me"
DATABASE_URL="postgresql://richards:richards_dev_change_me@localhost:5432/richards?schema=public"
# Banco SEPARADO para `pnpm test:integration` (o nome precisa terminar em _test; os testes apagam os dados DELE).
TEST_DATABASE_URL="postgresql://richards:richards_dev_change_me@localhost:5432/richards_test?schema=public"
DEMO_MODE="true"
# false somente em localhost durante desenvolvimento. Use true quando expuser a demonstração.
AUTH_MODE="basic"
RICHARDS_OPERATOR_USER="operador"
RICHARDS_OPERATOR_PASSWORD="troque-esta-senha"
IOT_DEMO_DEVICE_KEY="troque-esta-chave-dispositivo"
NEXT_PUBLIC_APP_NAME="RICHARDS Intelligence"
