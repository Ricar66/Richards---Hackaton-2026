generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Prisma exige um valor de enum por linha (forma em linha única não valida).
enum Role {
  OWNER
  OPERATOR
  ANALYST
  RECIPIENT
}

enum DeviceKind {
  FLOW
  SCALE
  TEMPERATURE
}

/// Equipamento da cadeia do frio/quente (RDC 216/2004, itens 4.8.15 e 4.8.16).
enum ColdKind {
  REFRIGERATOR
  FREEZER
  COLD_ROOM
  HOT_HOLDING
  AMBIENT
}

enum DeviceState {
  ONLINE
  OFFLINE
  MAINTENANCE
}

enum DataSource {
  DEVICE
  SIMULATED
  MANUAL
}

enum OccurrenceStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
  DISMISSED
}

enum OccurrenceSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum OccurrenceKind {
  UNUSUAL_FLOW
  DEVICE_OFFLINE
  TEMPERATURE_EXCURSION
  MANUAL
}

enum DonationStatus {
  PENDING_REVIEW
  AVAILABLE
  RESERVED
  DELIVERED
  CANCELLED
}

enum MissionKind {
  INSPECTION
  PICKUP
}

enum MissionStatus {
  OPEN
  ASSIGNED
  DONE
  CANCELLED
}

model Organization {
  id                    String                 @id @default(cuid())
  name                  String
  sector                String
  city                  String
  isDemo                Boolean                @default(false)
  createdAt             DateTime               @default(now())
  telegramSubscriptions TelegramSubscription[]
  telegramLinkCodes     TelegramLinkCode[]
  users                 User[]
  sites                 Site[]
  devices               Device[]
  occurrences           Occurrence[]
  donations             DonationBatch[]
  missions              Mission[]
  audit                 AuditEvent[]
  coldEquipments        ColdEquipment[]
}

model User {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  email          String       @unique
  role           Role         @default(OPERATOR)
  createdAt      DateTime     @default(now())
}

model Site {
  id             String          @id @default(cuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id])
  name           String
  description    String?
  devices        Device[]
  occurrences    Occurrence[]
  hydraulicMap   HydraulicMap?
  coldEquipments ColdEquipment[]
}

/// Planta hidráulica da unidade (esquema sem escala). Versão + bloqueio da unidade evitam sobrescrita entre abas.
model HydraulicMap {
  siteId    String   @id
  site      Site     @relation(fields: [siteId], references: [id], onDelete: Restrict)
  name      String
  layout    Json
  version   Int      @default(0)
  updatedBy String
  updatedAt DateTime @updatedAt
}

model Device {
  id                        String             @id @default(cuid())
  organizationId            String
  organization              Organization       @relation(fields: [organizationId], references: [id])
  siteId                    String
  site                      Site               @relation(fields: [siteId], references: [id])
  code                      String             @unique
  label                     String
  kind                      DeviceKind
  state                     DeviceState        @default(OFFLINE)
  apiKeyHash                String
  lastSeenAt                DateTime?
  calibrationPulsesPerLiter Float              @default(450)
  minFlowLpm                Float              @default(1.5)
  continuousSeconds         Int                @default(30)
  readings                  TelemetryReading[]
  occurrences               Occurrence[]
  coldEquipments            ColdEquipment[]

  @@index([organizationId, kind])
}

/// Geladeira, freezer, câmara fria, balcão quente ou estoque ambiente monitorado. A faixa vem do tipo (RDC 216);
/// limites próprios só valem se forem mais rigorosos (ver src/modules/cold-chain/domain/cold-chain.ts).
model ColdEquipment {
  id             String               @id @default(cuid())
  organizationId String
  organization   Organization         @relation(fields: [organizationId], references: [id])
  siteId         String
  site           Site                 @relation(fields: [siteId], references: [id])
  code           String               @unique
  label          String
  kind           ColdKind
  minC           Float?
  maxC           Float?
  /// Sensor que mede este equipamento e o canal no JSON do firmware (ex.: "TEMP", "TEMP_2").
  sensorDeviceId String?
  sensorDevice   Device?              @relation(fields: [sensorDeviceId], references: [id])
  sensorChannel  String               @default("TEMP")
  active         Boolean              @default(true)
  createdAt      DateTime             @default(now())
  readings       TemperatureReading[]
  donations      DonationBatch[]

  @@index([organizationId, active])
  @@index([sensorDeviceId])
}

/// Série gravada da temperatura (registro da RDC 216, item 4.8.18). Uma por minuto e toda virada de faixa.
/// A chave (equipamento, captura, origem) torna a retentativa da ponte idempotente.
model TemperatureReading {
  id           String        @id @default(cuid())
  equipmentId  String
  equipment    ColdEquipment @relation(fields: [equipmentId], references: [id])
  source       DataSource
  temperatureC Decimal       @db.Decimal(6, 2)
  humidityPct  Decimal?      @db.Decimal(5, 1)
  capturedAt   DateTime
  receivedAt   DateTime      @default(now())

  @@unique([equipmentId, capturedAt, source])
  @@index([equipmentId, capturedAt(sort: Desc)])
}

model TelemetryReading {
  id          String     @id @default(cuid())
  deviceId    String
  device      Device     @relation(fields: [deviceId], references: [id])
  bootId      String
  sequence    Int
  source      DataSource
  flowLpm     Decimal    @db.Decimal(12, 3)
  deltaLiters Decimal    @db.Decimal(12, 3)
  capturedAt  DateTime
  receivedAt  DateTime   @default(now())

  @@unique([deviceId, bootId, sequence])
  @@index([deviceId, capturedAt(sort: Desc)])
}

model Occurrence {
  id               String             @id @default(cuid())
  organizationId   String
  organization     Organization       @relation(fields: [organizationId], references: [id])
  siteId           String
  site             Site               @relation(fields: [siteId], references: [id])
  deviceId         String?
  device           Device?            @relation(fields: [deviceId], references: [id])
  kind             OccurrenceKind
  severity         OccurrenceSeverity @default(MEDIUM)
  status           OccurrenceStatus   @default(OPEN)
  source           DataSource
  title            String
  description      String
  suspectedLiters  Decimal?           @db.Decimal(12, 3)
  verificationNote String?
  openedAt         DateTime           @default(now())
  acknowledgedAt   DateTime?
  resolvedAt       DateTime?
  events           OccurrenceEvent[]
  missions         Mission[]

  @@index([organizationId, status, openedAt(sort: Desc)])
}

model OccurrenceEvent {
  id           String     @id @default(cuid())
  occurrenceId String
  occurrence   Occurrence @relation(fields: [occurrenceId], references: [id], onDelete: Cascade)
  action       String
  note         String?
  // Quem executou: "operador:<usuario>", "dispositivo:<codigo>" ou "simulador:<usuario>".
  actor        String?
  at           DateTime   @default(now())
}

model RecipientOrganization {
  id        String          @id @default(cuid())
  name      String
  city      String
  active    Boolean         @default(true)
  donations DonationBatch[]
}

model DonationBatch {
  id                String                 @id @default(cuid())
  organizationId    String
  organization      Organization           @relation(fields: [organizationId], references: [id])
  recipientId       String?
  recipient         RecipientOrganization? @relation(fields: [recipientId], references: [id])
  description       String
  weightKg          Decimal                @db.Decimal(12, 3)
  status            DonationStatus         @default(PENDING_REVIEW)
  source            DataSource             @default(MANUAL)
  safetyVerifiedBy  String?
  safetyVerifiedAt  DateTime?
  receivedAt        DateTime?
  // Pessoa da instituição que confirmou o recebimento (obrigatória para DELIVERED desde a Fase 4).
  receivedBy        String?
  cancelReason      String?
  createdAt         DateTime               @default(now())
  missions          Mission[]
  /// Equipamento onde o alimento estava guardado, declarado na triagem: o passaporte anexa a série de temperatura dele.
  originEquipmentId String?
  originEquipment   ColdEquipment?         @relation(fields: [originEquipmentId], references: [id])
  /// Passaporte do Alimento: token aleatório (128 bits, hex) da página pública /p/<token>. Sem token, sem página.
  passportToken     String?                @unique

  @@index([organizationId, status, createdAt(sort: Desc)])
}

// Expansão preparada: encaminhar incidentes e coletas como missões.
// CRUD e atribuições ficam fora do MVP de hackathon.
model Mission {
  id              String         @id @default(cuid())
  organizationId  String
  organization    Organization   @relation(fields: [organizationId], references: [id])
  occurrenceId    String?
  occurrence      Occurrence?    @relation(fields: [occurrenceId], references: [id])
  donationBatchId String?
  donationBatch   DonationBatch? @relation(fields: [donationBatchId], references: [id])
  kind            MissionKind
  status          MissionStatus  @default(OPEN)
  title           String
  assignedTo      String?
  createdAt       DateTime       @default(now())
  completedAt     DateTime?

  @@index([organizationId, status, createdAt(sort: Desc)])
}

model AuditEvent {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  entity         String
  entityId       String
  action         String
  metadata       Json?
  at             DateTime     @default(now())

  @@index([organizationId, at(sort: Desc)])
}

// Assistente opcional. Tabelas aditivas; nenhum dado operacional é alterado.
model TelegramSubscription {
  id               String                 @id @default(cuid())
  organizationId   String
  organization     Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actorHash        String
  chatId           String                 @unique
  active           Boolean                @default(true)
  includeSimulated Boolean                @default(false)
  dailySummary     Boolean                @default(false)
  linkedAt         DateTime               @default(now())
  history          Json                   @default("[]")
  historyAt        DateTime?
  deliveries       NotificationDelivery[]

  @@index([organizationId, actorHash])
}

model TelegramLinkCode {
  hash           String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actorHash      String
  expiresAt      DateTime
  consumedAt     DateTime?
}

model NotificationDelivery {
  id             String               @id @default(cuid())
  subscriptionId String
  subscription   TelegramSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  dedupeKey      String               @unique
  kind           String
  payload        Json
  status         String               @default("PENDING")
  attempts       Int                  @default(0)
  availableAt    DateTime             @default(now())
  leaseToken     String?
  leasedUntil    DateTime?
  sentAt         DateTime?
  lastError      String?
  createdAt      DateTime             @default(now())

  @@index([status, availableAt])
}

model AssistantUsage {
  key   String @id
  count Int    @default(0)
}

model AssistantWorkerState {
  key         String    @id
  offset      BigInt    @default(0)
  heartbeatAt DateTime?
}

model TelegramInbox {
  updateId    BigInt    @id
  chatId      String
  text        String
  receivedAt  DateTime  @default(now())
  replyText   String?
  processedAt DateTime?
  leaseToken  String?
  leasedUntil DateTime?
  attempts    Int       @default(0)
  lastError   String?
}
