// Firmware MQTT da bancada do Victor (ESP32-S3 + HX711 + DHT22). Base: PR #5.
// Copie para secrets.h (NÃO suba ao Git: iot/**/secrets.h está no .gitignore) e preencha.
#pragma once

#define WIFI_SSID "NOME_DO_SEU_WIFI"
#define WIFI_PASSWORD "SENHA_DO_WIFI"

// Broker da VPS (docs/DEPLOY_VPS_TETRIA.md, "Broker MQTT da bancada"). Na rede do evento sem internet, use o IP do
// notebook com o perfil iot (docker compose --profile iot up -d).
#define MQTT_BROKER_IP "187.77.229.205"
#define MQTT_BROKER_PORT 1883
// O usuário É o dispositivo_id: o broker só deixa este usuário publicar no PRÓPRIO tópico.
#define MQTT_USERNAME "hortifruti_01"
// Senha do dispositivo: recebida no privado (VPS_MQTT_DEVICE_PASSWORD). Nunca em chat, issue, PR ou foto.
#define MQTT_PASSWORD "SENHA_DO_DISPOSITIVO"
// Único tópico aceito pela ACL. O tópico compartilhado (sem /hortifruti_01) é recusado pelo broker.
#define MQTT_TOPIC "richards/comercio/telemetria/hortifruti_01"
#define DISPOSITIVO_ID "hortifruti_01"
